{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Filament Tray",
  "version": "0.1.0",
  "identifier": "com.yarasarda.filamenttray",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Filament",
        "width": 340,
        "height": 430,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
